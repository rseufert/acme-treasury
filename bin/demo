#!/bin/sh
# Start both mocks on a Monday morning, give them a week's worth to do, and
# forecast it. Needs mock-sap and mock-bank: pip install mock-sap mock-bank
set -e
here="$(cd "$(dirname "$0")/.." && pwd)"
python="${MOCK_PYTHON:-python3}"
export SAP_URL=http://127.0.0.1:8000 BANK_URL=http://127.0.0.1:8080

"$python" -m mocksap --port 8000 --clock 2026-10-05T09:00 -q > /dev/null &
sap=$!
"$python" -m mockbank --port 8080 --clock 2026-10-05T09:00 -q > /dev/null &
bank=$!
trap 'kill $sap $bank 2>/dev/null' EXIT
for url in $SAP_URL $BANK_URL; do
    until curl -s -o /dev/null "$url/_mock/health"; do sleep 0.2; done
done

world() { "$python" "$here/test/world.py" $SAP_URL $BANK_URL "$@" > /dev/null; }
world payable 1000013 INV-A 1200.00 2026-10-05
world payable 1000016 INV-B 80800.00 2026-10-07
world payable 1000013 INV-C 50.00 2026-10-05 A
world payable 1000016 INV-E 61450.00 2026-10-10
world receivable 1000006 42500.00 2026-10-13
curl -s -o /dev/null -X POST $BANK_URL/_mock/credits -H 'Content-Type: application/json' \
    -d '{"account": "ACME", "amount": 200000, "value_date": "2026-10-06", "note": "PAYMENT",
         "debtor": {"name": "Customer Ltd", "iban": "NL14MOCK0000000002"}}'

"$here/bin/mock-treasury" --days 8 --floor 10000 --plot "$@" || true
